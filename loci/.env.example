# Postgres / PostGIS  (docker-compose maps 5432 -> 5433 to avoid a local clash)
PGHOST=localhost
PGPORT=5433
PGDATABASE=loci
PGUSER=loci
PGPASSWORD=loci

# Census API — free, instant: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Google Places — VALIDATION SAMPLE ONLY. Pro SKU $32/1k, 5k/mo free.
# Request only id/name/location/types: ratings or hours reprice to Enterprise.
GOOGLE_PLACES_KEY=
LOCI_GOOGLE_CALL_BUDGET=5000
