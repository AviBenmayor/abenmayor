.env
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
data/raw/*
data/interim/*
data/processed/*
!data/**/.gitkeep
output/*
!output/.gitkeep
cache/
*.pmtiles
*.gpkg
.DS_Store

# reproducible database — never commit
*.duckdb
data/*.duckdb
*.pkl

# webmap generated data (regenerate from the DB)

# Loci query app DB must ship to Railway
!queryapp/loci_query.duckdb

# DuckDB backups taken before live rebuilds (D61 convention)
data/*.duckdb.bak*
data/*.duckdb.wal

# detector weights — fetched/exported, verified by sha256 in
# vision/person_detector.py, never committed (10 MB of binary)
data/models/
# camera frames kept only with --keep-frames, for QA. Public imagery of
# identifiable people on the street: it stays on the machine that fetched it.
data/frames/
# retrodiction panels — regenerated by `loci retrodiction run` (data, never committed)
data/retrodiction/
data/forecast_challenge/
data/ground_truth/
# sidewalk sweep working files (spool parquet, scene-hash state, logs) and the
# generated launchd plists -- local, never committed (memo 2026-09-17 §1e)
data/sidewalk/
data/launchd/
# aerial change / awning / convertible review pages and cached ortho tiles
data/aerial/
# chains watchlist snapshots, commercial-listings collector output, and
# generated data exports (data, never committed) — D133
data/chains/
data/commercial_listings/
data/exports/

# Codex peer session's agent hand-off skills — kept local-only pending an
# owner decision on whether it ships (D133)
.codex/
